# Local development only. These credentials never leave your machine — the
# container is not exposed beyond localhost and nothing here is a real secret.
# Copy to .env to override; every default below is also baked into
# docker-compose.yml and scripts/lib.sh, so .env is optional.

# Container superuser. Used only by initdb and by the test fixture loader
# (fixtures are seeded out-of-band on purpose — see db/tests/000_fixtures.sql).
POSTGRES_PASSWORD=postgres

# DDL / migration owner. Owns every table; migrations connect as this role.
FS_OWNER_PASSWORD=owner_dev_password

# The application role. This is the only role the API ever connects as.
FS_APP_PASSWORD=app_dev_password

# The control-plane role (CLAUDE.md §7.1). Separate application, separate
# origin, separate credentials — never the app role with extra grants.
FS_ADMIN_PASSWORD=admin_dev_password

FS_DB_NAME=flightsquare
FS_DB_PORT=5432
