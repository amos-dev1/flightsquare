{
  "name": "@flightsquare/infra",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "_synth": "cdk synth with no stack and no profile cannot work: the app builds both stacks, and synthesising prod needs credentials for its own account to look up availability zones. One script per environment, matching diff and deploy.",
    "synth:dev": "cdk synth FlightSquareDev --profile flightsquare-dev",
    "synth:prod": "cdk synth FlightSquareProd --profile flightsquare-prod",
    "diff:dev": "cdk diff FlightSquareDev --profile flightsquare-dev",
    "deploy:dev": "cdk deploy FlightSquareDev --profile flightsquare-dev",
    "diff:prod": "cdk diff FlightSquareProd --profile flightsquare-prod",
    "deploy:prod": "cdk deploy FlightSquareProd --profile flightsquare-prod"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "aws-cdk": "^2.160.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aws-cdk/aws-apprunner-alpha": "2.160.0-alpha.0",
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
