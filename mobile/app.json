{
  "expo": {
    "name": "FlightSquare",
    "slug": "flightsquare",
    "owner": "emtuzas",
    "scheme": "flightsquare",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flightsquare.app"
    },
    "android": {
      "package": "com.flightsquare.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "FlightSquare uses your photos so you can attach a picture of a defect to a squawk.",
          "cameraPermission": "FlightSquare uses the camera so you can photograph a defect while you are at the aircraft."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
